# Copy this file to .env and fill in what you use. Empty = switched off.
# NEVER commit your real .env (it is in .gitignore).

# ---------- Required for voice ----------
GNANI_API_KEY=

# ---------- Restaurant ----------
RESTAURANT_NAME=My Restaurant
RESTAURANT_ADDRESS=
UPI_ID=restaurant@upi
UPI_PAYEE_NAME=

# ---------- Security (set these before going public) ----------
# Long random text, e.g. from:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Shared PIN for the dashboard. Or create staff logins:  python -m scripts.add_staff
STAFF_PIN=
# 1 only when running behind nginx / Caddy / Render (so the real visitor IP is used)
TRUST_PROXY=0
# 1 only on your own computer, never on a server
FLASK_DEBUG=0

# ---------- GST on the bill ----------
# 5 = 5% (shown as 2.5% CGST + 2.5% SGST). 0 = no GST lines.
GST_RATE=0
GSTIN=

# ---------- Kitchen waiting-time estimate ----------
PREP_MINUTES=10
MINUTES_PER_ORDER_AHEAD=3

# ---------- Abuse protection (requests per visitor per minute) ----------
RATE_LIMIT_TURN=40
RATE_LIMIT_VOICE=20
MAX_TEXT_CHARS=300

# ---------- Razorpay: automatic UPI payment check (optional) ----------
# Webhook URL: https://YOUR-SITE/payments/razorpay/webhook  events: qr_code.credited, payment_link.paid
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------- Customer messages (optional): WhatsApp first, else SMS ----------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template with ONE body variable {{1}}
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en
TWILIO_SMS_FROM=
COUNTRY_CODE=91

# ---------- Telephone ordering (optional, Twilio) ----------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PUBLIC_BASE_URL=
PHONE_DEV=0

# ---------- Tamil / Telugu voices (names from Gnani's Timbre voice catalog) ----------
GNANI_VOICE_TA=
GNANI_VOICE_TE=

# ---------- Optional LLM (any OpenAI-compatible API) ----------
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# off | fallback | always
LLM_MODE=fallback
LLM_TIMEOUT=8
LLM_EXTRA=

# ---------- Where the database lives (default: restaurant.db in the project folder) ----------
DATABASE_PATH=
